# Django Core Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ENV=development
# For LAN testing, add the computer's LAN IP, e.g. 192.168.1.25
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
# SQLite (default)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# PostgreSQL (production)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=lynqart_db
# DB_USER=postgres
# DB_PASSWORD=your-database-password
# DB_HOST=localhost
# DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
CORS_ALLOW_ALL_ORIGINS=False
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173

# LAN development example (replace 192.168.1.25 with this computer's LAN IP):
# ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.25
# CORS_ALLOWED_ORIGINS=http://192.168.1.25:5173
# CSRF_TRUSTED_ORIGINS=http://192.168.1.25:5173
# FRONTEND_BASE_URL=http://192.168.1.25:5173

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME=3600
JWT_REFRESH_TOKEN_LIFETIME=604800

# Cloudinary Image Storage (optional)
CLOUDINARY_ENABLED=False
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email Configuration (optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# AI Integration Configuration (OpenRouter)
AI_PROVIDER=openrouter
AI_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Application Settings
TIME_ZONE=UTC
LANGUAGE_CODE=en-us
